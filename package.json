{
  "name": "compliancehub",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "packageManager": "npm@11.9.0",
  "scripts": {
    "dev": "PORT=3100 next dev",
    "build": "next build",
    "start": "PORT=3100 next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:db": "supabase test db",
    "test:db:upgrade": "bash scripts/test-db-upgrade.sh",
    "test:e2e": "playwright test",
    "github:shadow-proof": "node --conditions=react-server --import=tsx scripts/github-shadow-proof.ts",
    "demo:ceo-fixture": "node --import=tsx scripts/local-ceo-demo-fixture.ts",
    "verify": "npm run lint && npm run typecheck && npm test && npm run build",
    "demo:build": "node --import=tsx scripts/demo-local.ts build",
    "demo:start": "node --import=tsx scripts/demo-local.ts start",
    "demo:setup": "node --import=tsx scripts/demo-local.ts setup",
    "demo:verify": "node --import=tsx scripts/demo-local.ts setup -- --verify-only"
  },
  "dependencies": {
    "@modelcontextprotocol/core": "2.0.0",
    "@modelcontextprotocol/node": "2.0.0",
    "@modelcontextprotocol/server": "2.0.0",
    "@nangohq/frontend": "0.70.9",
    "@supabase/ssr": "^0.12.0",
    "@supabase/supabase-js": "^2.110.0",
    "clsx": "^2.1.1",
    "docx": "^9.7.1",
    "exceljs": "^4.4.0",
    "jose": "6.2.8",
    "next": "16.3.0",
    "pdfkit": "^0.19.1",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "tailwind-merge": "^3.6.0",
    "yauzl": "3.4.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@modelcontextprotocol/client": "2.0.0",
    "@playwright/test": "^1.61.1",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^20",
    "@types/pdfkit": "^0.17.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/yauzl": "3.4.0",
    "@vitejs/plugin-react": "^6.0.3",
    "axe-core": "^4.12.1",
    "eslint": "^9",
    "eslint-config-next": "16.3.0",
    "jsdom": "^29.1.1",
    "server-only": "0.0.1",
    "supabase": "^2.109.0",
    "tailwindcss": "^4",
    "tsx": "4.23.13",
    "typescript": "^5",
    "vitest": "^4.1.9"
  }
}
